# ===========================================================
# UniPlan Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env!
# ===========================================================

# --- Django Core ---
DJANGO_SECRET=__CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY__
DEBUG=0                                # 1=dev, 0=production (V13.4.2)
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
DB_NAME=uniplan
DB_USER=uniplan
DB_PASSWORD=__CHANGE_ME__
DB_HOST=localhost                      # 'db' in Docker Compose
DB_PORT=3306

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Google OAuth (V13.3.1: never commit real values) ---
GOOGLE_CLIENT_ID=__CHANGE_ME__
GOOGLE_CLIENT_SECRET=__CHANGE_ME__
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# --- Frontend URL for OAuth redirect ---
FRONTEND_REDIRECT=http://localhost:5173

# --- Email (optional) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Uniplan <no-reply@uniplan.local>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
